৩. ডায়নামিক ডেটা লোড করার JavaScript (Firebase Auth সহ)
আপনি যদি প্রজেক্টে Firebase Authentication (Google Sign-In) ব্যবহার করে থাকেন, তবে নিচের কোড দিয়ে খুব সহজেই ইউজারের জিমেইল নাম, ইমেইল এবং অটো জিমেইল প্রোফাইল ছবি তুলে আনতে পারবেন:
// ফায়ারবেস অথেন্টিকেশন চেক করা
firebase.auth().onAuthStateChanged((user) => {
    if (user) {
        // ইউজার লগইন করা আছে, ডেটা ফেচ করা হচ্ছে
        const displayName = user.displayName || "নাম পাওয়া যায়নি";
        const email = user.email;
        
        // **জিমেইলের নিজস্ব প্রোফাইল ছবি automatically চলে আসবে** 
        // যদি কাস্টম ছবি না থাকে, ফায়ারবেস থেকে user.photoURL দিয়ে জিমেইলের ছবি পেয়ে যাবো
        const photoURL = user.photoURL || "https://via.placeholder.com/150";

        // HTML এলিমেন্টে ডেটা বসানো
        document.getElementById('user-name').innerText = displayName;
        document.getElementById('user-email').innerText = email;
        document.getElementById('user-avatar').src = photoURL;

        // এখানে আপনি ইউজারের অন্যান্য ডাটাবেজ ডাটা (যেমন সার্ভার থেকে তার অ্যাক্টিভিটি) লোড করতে পারেন
        loadUserActivity(user.uid);

    } else {
        // ইউজার লগইন করা না থাকলে সরাসরি লগইন পেজে রিডাইরেক্ট করে দেওয়া
        window.location.href = "login.html";
    }
});

// লগআউট ফাংশনালিটি
document.getElementById('logout-btn').addEventListener('click', () => {
    firebase.auth().signOut().then(() => {
        window.location.href = "login.html";
    }).catch((error) => {
        console.error("লগআউট করতে সমস্যা হয়েছে: ", error);
    });
});

// ইউজারের নিজস্ব তথ্য বা হিস্ট্রি লোড করার ডামি ফাংশন
function loadUserActivity(uid) {
    // এখানে আপনার ডাটাবেজ থেকে ইউজারের পোস্ট বা ইনফো ফেচ করার কোড বসবে
    console.log("Current User UID:", uid);
}

কীভাবে কাজ করবে?
১. কোনো ইউজার যখন জিমেইল দিয়ে সাইন-ইন করবে, তখন Google এর নিয়ম অনুযায়ী তার জিমেইলের প্রোফাইল পিকচার ফায়ারবেস স্বয়ংক্রিয়ভাবে user.photoURL-এ সেভ করে নেয়।
২. জাভাস্ক্রিপ্ট কোডটি ওই photoURL রিড করে প্রোফাইল পেজের গোল ইমেজ ট্যাগটিতে বসিয়ে দেয়। ফলে ছবি ম্যানুয়ালি আপলোড ছাড়াই জিমেইলের ছবি শো করবে।
