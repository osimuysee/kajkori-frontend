
আপনার ওয়েবসাইটের কর্মীদের (Staff/Workers) জন্য কার্ডগুলোকে আধুনিক, ডিজিটাল এবং ডায়নামিক করতে গ্লাসমরফিজম (Glassmorphism) ইফেক্ট, সুন্দর হোভার অ্যানিমেশন এবং স্পষ্ট ছবিসহ একটি আকর্ষণীয় ডিজাইন তৈরি করতে পারেন।
নিচে এর জন্য একটি চমৎকার HTML, CSS এবং JavaScript কোড টেমপ্লেট দেওয়া হলো, যা আপনি আপনার প্রজেক্টে ব্যবহার করতে পারবেন:
১. HTML স্ট্রাকচার (একটি ডায়নামিক কন্টেইনারসহ)
আপনার ওয়েবসাইটের যে অংশে কর্মীদের তালিকা দেখাবেন, সেখানে এই কোডটি রাখুন:
<!-- কর্মী কার্ডগুলোর কন্টেইনার -->
<div id="staff-container" class="staff-grid">
    <!-- ডায়নামিকভাবে কার্ডগুলো এখানে লোড হবে -->
</div>

২. আধুনিক ও ডিজিটাল স্টাইল (CSS)
এই CSS কোডটি আপনার স্টাইলশিটে (style.css) যুক্ত করুন:
/* গ্রিড লেআউট */
.staff-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    padding: 20px;
}

/* ডিজিটাল গ্লাস কার্ড ডিজাইন */
.staff-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 25px 20px;
    text-align: center;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

/* হোভার ইফেক্ট */
.staff-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px 0 rgba(0, 242, 254, 0.25);
    border-color: rgba(0, 242, 254, 0.4);
}

/* প্রোফাইল ছবি কন্টেইনার */
.staff-img-container {
    position: relative;
    width: 100px;
    height: 100px;
    margin: 0 auto 15px auto;
}

.staff-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #00f2fe;
    box-shadow: 0 0 15px rgba(0, 242, 254, 0.5);
}

/* স্ট্যাটাস ব্যাজ (Active) */
.status-badge {
    position: absolute;
    bottom: 2px;
    right: 2px;
    background: #00ff88;
    color: #000;
    font-size: 10px;
    padding: 3px 8px;
    border-radius: 10px;
    font-weight: bold;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
}

/* কর্মীর তথ্য */
.staff-info h3 {
    margin: 10px 0 5px;
    color: #ffffff;
    font-size: 18px;
    font-weight: 600;
}

.staff-info .designation {
    color: #00f2fe;
    font-size: 14px;
    margin-bottom: 8px;
    font-weight: 500;
}

.staff-info .join-date {
    color: #a0a0a0;
    font-size: 12px;
}

৩. ডায়নামিক রেন্ডারিং (JavaScript)
ডাটাবেজ বা অ্যারে (Array) থেকে ডেটা এনে স্বয়ংক্রিয়ভাবে কার্ড তৈরি করার জন্য জাভাস্ক্রিপ্ট কোডটি ব্যবহার করুন:
// আপনার কর্মীদের ডাটা (এটি আপনি ডাটাবেজ থেকেও আনতে পারেন)
const staffMembers = [
    {
        name: "রহিম উদ্দিন",
        designation: "Senior Developer",
        image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150",
        joinDate: "Joined: Aug 2026",
        status: "Active"
    },
    {
        name: "ফাতেমা আক্তার",
        designation: "UI/UX Designer",
        image: "https://images.unsplash.com/photo-1517841905240-472988babdf9?w=150",
        joinDate: "Joined: Aug 2026",
        status: "Active"
    }
];

// ডায়নামিকভাবে কার্ডগুলো HTML-এ ইনজেক্ট করা
const container = document.getElementById('staff-container');

function renderStaffCards() {
    container.innerHTML = ""; // আগের কন্টেন্ট ক্লিয়ার করা
    staffMembers.forEach(staff => {
        const cardHTML = `
            <div class="staff-card">
                <div class="staff-img-container">
                    <img src="${staff.image}" alt="${staff.name}" class="staff-img">
                    <span class="status-badge">${staff.status}</span>
                </div>
                <div class="staff-info">
                    <h3>${staff.name}</h3>
                    <p class="designation">${staff.designation}</p>
                    <p class="join-date">${staff.joinDate}</p>
                </div>
            </div>
        `;
        container.innerHTML += cardHTML;
    });
}

// পেজ লোড হলে ফাংশনটি রান হবে
document.addEventListener("DOMContentLoaded", renderStaffCards);

এই কোডটি যুক্ত করলে আপনার সাইটে কর্মীরা যোগ দিলে তাদের ছবিসহ খুব প্রিমিয়াম, গ্লাস-উইন্ডো স্টাইলের ডিজিটাল কার্ড ডায়নামিকভাবে শো করবে। কোডগুলো আপনার প্রজেক্টে বসিয়ে চেক করে দেখতে পারেন! কোনো সমস্যা হলে আমাকে জানান।












