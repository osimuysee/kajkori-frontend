        };

        if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();
        const storage = firebase.storage();

        // 📍 ড্রপডাউন সেটআপ
        document.addEventListener('DOMContentLoaded', function() {
            const divisionSelect = document.getElementById('division');
            const districtSelect = document.getElementById('district');
            const upazilaSelect = document.getElementById('upazila');

            if (typeof bdGeoData !== 'undefined') {
                for (const divKey in bdGeoData) {
                    const opt = document.createElement('option');
                    opt.value = divKey;
                    opt.innerText = bdGeoData[divKey].name;
                    divisionSelect.appendChild(opt);
                }

                divisionSelect.addEventListener('change', function() {
                    districtSelect.innerHTML = '<option value="">জেলা</option>';
                    upazilaSelect.innerHTML = '<option value="">উপজেলা</option>';
                    if (this.value && bdGeoData[this.value]) {
                        for (const distKey in bdGeoData[this.value].districts) {
                            const opt = document.createElement('option');
                            opt.value = distKey;
                            opt.innerText = bdGeoData[this.value].districts[distKey].name;
                            districtSelect.appendChild(opt);
                        }
                    }
                });

                districtSelect.addEventListener('change', function() {
                    upazilaSelect.innerHTML = '<option value="">উপজেলা</option>';
                    const div = divisionSelect.value;
                    if (div && this.value && bdGeoData[div]?.districts[this.value]) {
                        bdGeoData[div].districts[this.value].upazilas.forEach(upazilaName => {
                            const opt = document.createElement('option');
                            opt.value = upazilaName;
                            opt.innerText = upazilaName;
                            upazilaSelect.appendChild(opt);
                        });
                    }
                });
            }
        });

        // 📝 আবেদন সাবমিট লজিক
        document.getElementById('registerForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const nid = document.getElementById('nid').value.trim();
            const submitBtn = document.getElementById('submitBtn');

            submitBtn.disabled = true;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> প্রসেসিং হচ্ছে...`;

            try {
                // ১. ডুপ্লিকেট NID চেক
                const checkNid = await db.collection("workers").where("nid", "==", nid).get();
                if (!checkNid.empty) {
                    Swal.fire('এরর!', 'এই NID নম্বর দিয়ে ইতোমধ্যে আবেদন করা হয়েছে।', 'error');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = `<i class="fa-solid fa-paper-plane"></i> আবেদন সাবমিট করুন`;
                    return;
                }

                // ২. ছবি আপলোড (যদি সিলেক্ট করা থাকে)
                let profileImageUrl = "";
                let nidImageUrl = "";

                const profileFile = document.getElementById('profileImage').files[0];
                const nidFile = document.getElementById('nidImage').files[0];

                if (profileFile) {
                    const pRef = storage.ref(`workers/profile_${Date.now()}_${profileFile.name}`);
                    await pRef.put(profileFile);
                    profileImageUrl = await pRef.getDownloadURL();
                }

                if (nidFile) {
                    const nRef = storage.ref(`workers/nid_${Date.now()}_${nidFile.name}`);
                    await nRef.put(nidFile);
                    nidImageUrl = await nRef.getDownloadURL();
                }

                // ৩. ডাটাবেজে সেভ করা
                await db.collection("workers").add({
                    fullName: document.getElementById('fullName').value.trim(),
                    phone: document.getElementById('phone').value.trim(),
                    nid: nid,
                    category: document.getElementById('category').value,
                    perTaskCharge: document.getElementById('perTaskCharge').value,
                    division: document.getElementById('division').value,
                    district: document.getElementById('district').value,
                    upazila: document.getElementById('upazila').value,
                    village: document.getElementById('village').value.trim(),
                    profileImageUrl: profileImageUrl,
                    nidImageUrl: nidImageUrl,
                    status: "pending",
                    createdAt: firebase.firestore.FieldValue.serverTimestamp()
                });

                Swal.fire({
                    icon: 'success',
                    title: 'আবেদন সফল হয়েছে!',
                    text: 'আপনার তথ্য যাচাই করে এডমিন প্যানেল থেকে অনুমোদন দেওয়া হবে।',
                }).then(() => {
                    window.location.href = "index.html";
                });

            } catch (error) {
                console.error(error);
                Swal.fire('ভুল হয়েছে!', error.message, 'error');
                submitBtn.disabled = false;
                submitBtn.innerHTML = `<i class="fa-solid fa-paper-plane"></i> আবেদন সাবমিট করুন`;
            }
        });
    </script>
